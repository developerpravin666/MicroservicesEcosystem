{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AccountingInventory API",
      "presentation": { "hidden": true },
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/AccountingInventory/AccountingInventory.Api/bin/Debug/net10.0/AccountingInventory.Api.dll",
      "cwd": "${workspaceFolder}/src/AccountingInventory/AccountingInventory.Api",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:64113;http://localhost:64114"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "API Gateway",
      "presentation": { "hidden": true },
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Gateway/ApiGateway/bin/Debug/net10.0/ApiGateway.dll",
      "cwd": "${workspaceFolder}/src/Gateway/ApiGateway",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:64115;http://localhost:64116"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/health"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch APIs (Browser)",
      "configurations": [
        "AccountingInventory API",
        "API Gateway"
      ],
      "preLaunchTask": "build solution",
      "stopAll": true
    }
  ]
}

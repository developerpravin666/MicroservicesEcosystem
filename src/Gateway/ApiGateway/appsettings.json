{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "accounting-inventory-route": {
        "ClusterId": "accounting-inventory-cluster",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-Gateway",
            "Set": "ApiGateway"
          }
        ]
      }
    },
    "Clusters": {
      "accounting-inventory-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "accounting-inventory-1": { "Address": "https://localhost:64113/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}

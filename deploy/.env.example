# Shared across every compose file in this folder. Copy to ".env" and edit before
# deploying anywhere but a laptop.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
JWT_SIGNING_KEY=REPLACE_WITH_A_STRONG_64_CHAR_MINIMUM_SECRET_STORED_IN_A_VAULT
JWT_ISSUER=microservices-ecosystem
JWT_AUDIENCE=microservices-ecosystem-clients
